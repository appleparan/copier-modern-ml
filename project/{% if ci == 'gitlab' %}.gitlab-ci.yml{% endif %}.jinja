variables:
  UV_VERSION: "0.12.4"  # uv version
  PYTHON_VERSION: "3.14"  # basic Python version
  BASE_LAYER: "trixie-slim"  # uv base image
  UV_CACHE_DIR: "$CI_PROJECT_DIR/.uv-cache"  # cache directory

stages:
  - lint
  - test
  - release

# Lint job
lint:
  stage: lint
  parallel:
    matrix:
      - PYTHON_VERSION: "3.12"
      - PYTHON_VERSION: "3.13"
      - PYTHON_VERSION: "3.14"
  image: ghcr.io/astral-sh/uv:$UV_VERSION-python$PYTHON_VERSION-$BASE_LAYER
  script:
    - echo "Using UV version $UV_VERSION with Python $PYTHON_VERSION"
    - echo "Installing project dependencies"
    - uv sync --group dev --group docs{% if use_torch %} --extra cpu{% endif %} --frozen
    - echo "Running format checks"
    - uv run ruff format --check .
    - echo "Running lint checks"
    - uv run ruff check .
    - echo "Running type checks"
    - uv run ty check
    - echo "Building documentation"
    - uv run mkdocs build --strict
  cache:
    paths:
      - .uv-cache/

# Test job
test:
  stage: test
  needs:
    - lint
  parallel:
    matrix:
      - PYTHON_VERSION: "3.12"
      - PYTHON_VERSION: "3.13"
      - PYTHON_VERSION: "3.14"
  image: ghcr.io/astral-sh/uv:$UV_VERSION-python$PYTHON_VERSION-$BASE_LAYER
  script:
    - echo "Using UV version $UV_VERSION with Python $PYTHON_VERSION"
    - echo "Installing project dependencies"
    - uv sync --group dev --group docs{% if use_torch %} --extra cpu{% endif %} --frozen
    - echo "Running tests"
    - uv run coverage run -m pytest tests/
  cache:
    paths:
      - .uv-cache/

release:
  stage: release
  image: ghcr.io/astral-sh/uv:$UV_VERSION-python$PYTHON_VERSION-$BASE_LAYER
  # Run when specific tag was pushed
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/'  # Run tags matched with 'v*.*.*'
    - when: manual  # also allow manual runs
  script:
    - echo "Checking permissions for release..."
    # Like GitHub's actions-check-permissions
    - if [ -z "$CI_JOB_TOKEN" ]; then echo "No CI_JOB_TOKEN available, exiting"; exit 1; fi

    - echo "Setting up Git configuration..."
    - git config --global user.name "$CI_COMMIT_AUTHOR_NAME"
    - git config --global user.email "$CI_COMMIT_AUTHOR_EMAIL"

    - echo "Fetching tags..."
    - git fetch --tags

    - echo "Creating release for tag $CI_COMMIT_TAG..."
    # Create GitLab Release
    - >
      curl --header "JOB-TOKEN: $CI_JOB_TOKEN"
      --data "name=Release $CI_COMMIT_TAG&tag_name=$CI_COMMIT_TAG&description=$(cat RELEASE.md)"
      "$CI_API_V4_URL/projects/$CI_PROJECT_ID/releases"

  tags:
    - release-runner  # GitLab runner tag
