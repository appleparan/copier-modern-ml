"""Semantic search example using a frozen sentence-embedding model.

This module embeds text with the frozen `BAAI/bge-small-en-v1.5` encoder and
ranks a small built-in corpus by cosine similarity to a query. It performs
inference only: there is no training loop and no dataset download beyond the
pretrained model weights.

Run it via the CLI::

    {{ project_slug }}-cli nlp --query "How do I keep my houseplants alive?" --top-k 3
"""

from collections.abc import Sequence
from dataclasses import dataclass

import torch
import torch.nn.functional as functional
from transformers import AutoModel, AutoTokenizer, PreTrainedModel, PreTrainedTokenizerBase

DEFAULT_MODEL_NAME = 'BAAI/bge-small-en-v1.5'

DEFAULT_CORPUS: tuple[str, ...] = (
    'Water your houseplants once the top inch of soil feels dry.',
    'Python list comprehensions are a concise way to build lists.',
    'Boil the pasta in salted water until it is al dente.',
    'The James Webb telescope captures infrared light from distant galaxies.',
    'Shift your weight back and cover the front brake when cycling downhill.',
    'An emergency fund should cover three to six months of living expenses.',
    'Repot a houseplant when its roots start growing through the drainage holes.',
    'Type hints let static analyzers catch bugs before Python code runs.',
    'A pinch of salt in the pasta water seasons the noodles as they cook.',
    'Neutron stars are the collapsed cores left behind by supernova explosions.',
)


@dataclass(frozen=True)
class SearchResult:
    """A single scored corpus entry returned by `semantic_search`.

    Attributes:
        text: The corpus sentence.
        score: Cosine similarity between the query and this sentence, in [-1, 1].
    """

    text: str
    score: float


@dataclass(frozen=True)
class TextEncoder:
    """A frozen transformer encoder that turns text into normalized embeddings.

    Attributes:
        tokenizer: The tokenizer matching `model`.
        model: A HuggingFace encoder model in eval mode.
    """

    tokenizer: PreTrainedTokenizerBase
    model: PreTrainedModel

    @classmethod
    def from_pretrained(cls, model_name: str = DEFAULT_MODEL_NAME) -> 'TextEncoder':
        """Load the tokenizer and model for `model_name`.

        Args:
            model_name: HuggingFace model identifier. Defaults to
                `DEFAULT_MODEL_NAME`.

        Returns:
            A `TextEncoder` ready for inference.
        """
        tokenizer = AutoTokenizer.from_pretrained(model_name)
        assert isinstance(tokenizer, PreTrainedTokenizerBase)  # noqa: S101
        model = AutoModel.from_pretrained(model_name)
        model.eval()
        return cls(tokenizer=tokenizer, model=model)

    def encode(
        self, texts: Sequence[str], *, batch_size: int = 32, max_length: int = 512
    ) -> torch.Tensor:
        """Embed `texts` into L2-normalized vectors.

        Args:
            texts: Sentences to embed.
            batch_size: Number of texts encoded per forward pass.
            max_length: Maximum token length; longer inputs are truncated.

        Returns:
            A `(len(texts), hidden_size)` tensor of L2-normalized embeddings.
        """
        batches = []
        with torch.inference_mode():
            for start in range(0, len(texts), batch_size):
                batch = list(texts[start : start + batch_size])
                inputs = self.tokenizer(
                    batch,
                    padding=True,
                    truncation=True,
                    max_length=max_length,
                    return_tensors='pt',
                )
                outputs = self.model(**inputs)
                cls_embeddings = outputs.last_hidden_state[:, 0]
                batches.append(functional.normalize(cls_embeddings, p=2, dim=1))
        return torch.cat(batches, dim=0)


def semantic_search(
    encoder: TextEncoder,
    query: str,
    corpus: Sequence[str] = DEFAULT_CORPUS,
    *,
    top_k: int = 3,
) -> list[SearchResult]:
    """Rank `corpus` by cosine similarity to `query`.

    Args:
        encoder: A loaded `TextEncoder`.
        query: The search query.
        corpus: Candidate sentences to rank. Defaults to `DEFAULT_CORPUS`.
        top_k: Maximum number of results to return, clamped to `len(corpus)`.

    Returns:
        The `top_k` highest-scoring `SearchResult`s, sorted by descending score.

    Raises:
        ValueError: If `top_k` is not a positive integer or `corpus` is empty.
    """
    if top_k < 1:
        error_message = f'top_k must be >= 1, got {top_k}'
        raise ValueError(error_message)
    if not corpus:
        error_message = 'corpus must not be empty'
        raise ValueError(error_message)

    query_embedding = encoder.encode([query])
    corpus_embeddings = encoder.encode(list(corpus))
    scores = (corpus_embeddings @ query_embedding.T).squeeze(1)

    ranked = sorted(zip(corpus, scores.tolist(), strict=True), key=lambda pair: -pair[1])
    return [
        SearchResult(text=text, score=score) for text, score in ranked[: min(top_k, len(corpus))]
    ]
