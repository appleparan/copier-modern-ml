# Convenience wrappers around the project's uv-based toolchain.
# Run `make <target>` from the project root.

.PHONY: setup format lint typecheck test docs build clean

setup:
	uv sync --group dev --group docs{% if use_torch %} --extra cpu{% endif %}

format:
	uv run ruff format .

lint:
	uv run ruff check --fix .

typecheck:
	uv run ty check

test:
	uv run pytest

docs:
	uv run mkdocs build --strict

build:
	uv build

clean:
	rm -rf build dist htmlcov site .coverage* .pytest_cache .ruff_cache
