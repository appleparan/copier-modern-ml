# Example environment file.
#
# uv does NOT read .env automatically. Load it yourself with one of:
#   set -a; . ./.env; set +a
#   direnv (https://direnv.net/)
#   uv run --env-file .env <command>
#
# The FastAPI settings (pydantic-settings, see src/*/api/settings.py) DO
# read .env automatically.
#
# Copy this file to .env and uncomment/edit the values you need:
#   cp .env.example .env

# --- API settings ---------------------------------------------------------

# API_HOST=0.0.0.0          # Host the API server binds to
# API_PORT=5000              # Port the API server listens on
# DEBUG=false                # Enable debug mode
# LOG_LEVEL=INFO              # Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]  # JSON list of allowed CORS origins
# MAX_WORKERS=1               # Maximum number of server workers
# MODEL_NAME=default          # Model name to use
# MODEL_PATH=models/          # Path to model files
# MAX_BATCH_SIZE=32           # Maximum batch size for predictions
# TIMEOUT_SECONDS=30.0        # Request timeout in seconds

# --- Corporate network -----------------------------------------------------
# See docs/enterprise-network.md for the full explanation of each variable.

# UV_SYSTEM_CERTS=true                          # Trust the OS certificate store instead of uv's bundled roots
# SSL_CERT_FILE=/path/to/bundle.pem              # Full PEM bundle (replaces uv's bundled roots entirely)
# REQUESTS_CA_BUNDLE=/path/to/bundle.pem         # Same bundle, for requests-based tools (e.g. huggingface_hub)
# UV_DEFAULT_INDEX=https://pypi.internal.example.com/simple  # Replace the default package index
# UV_INDEX=https://extra1.example.com/simple https://extra2.example.com/simple  # Space-separated extra indexes
# UV_PYTHON_INSTALL_MIRROR=https://python-mirror.internal.example.com  # Mirror for managed Python downloads
# HF_ENDPOINT=https://hf.internal.example.com    # Internal Hugging Face Hub mirror
# HTTPS_PROXY=http://proxy.internal.example.com:8080  # HTTPS proxy
# HTTP_PROXY=http://proxy.internal.example.com:8080   # HTTP proxy
# NO_PROXY=localhost,127.0.0.1,.internal.example.com  # Hosts to bypass the proxy for
